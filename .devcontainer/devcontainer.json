{
  "name": "n8n + MCP classroom",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/n8n-mcp-classroom",
  "forwardPorts": [5678],
  "portsAttributes": {
    "5678": { "label": "n8n editor", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "cp -n .env.example .env && npm install -g @anthropic-ai/claude-code",
  "postAttachCommand": "echo '\\n👉 Open the PORTS tab → 5678 to reach n8n. Then follow LESSON.md\\n'",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  }
}
