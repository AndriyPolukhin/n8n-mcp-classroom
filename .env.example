# Where your n8n lives. In Codespaces / local Docker this is correct as-is.
N8N_URL=http://localhost:5678

# n8n → Settings → n8n API → Create an API key. Never commit the real value.
N8N_API_KEY=

# Optional: id of your OpenRouter credential in n8n (open the credential, copy the id from the URL).
# If set, scripts/import.mjs attaches it to the OpenRouter model nodes automatically.
OPENROUTER_CREDENTIAL_ID=
