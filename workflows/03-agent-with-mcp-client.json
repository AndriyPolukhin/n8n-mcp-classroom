{
  "name": "Classroom · 03 Chat Agent using MCP tools",
  "nodes": [
    {
      "id": "c3f0c003-0000-4000-8000-000000000001",
      "name": "Chat",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "webhookId": "classroom-chat",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "c3f0c003-0000-4000-8000-000000000002",
      "name": "Course Assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        280,
        0
      ],
      "parameters": {
        "promptType": "auto",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are a helpful course assistant. You have tools that come from an MCP server (word_stats, make_slug, course_schedule). Always use a tool when it can answer more precisely than you. Answer in the user's language and mention which tool you used."
        }
      }
    },
    {
      "id": "c3f0c003-0000-4000-8000-000000000003",
      "name": "OpenRouter Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        120,
        240
      ],
      "parameters": {
        "model": "openai/gpt-4.1-mini",
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "c3f0c003-0000-4000-8000-000000000004",
      "name": "Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        300,
        240
      ],
      "parameters": {
        "contextWindowLength": 10
      }
    },
    {
      "id": "c3f0c003-0000-4000-8000-000000000005",
      "name": "Classroom MCP Tools",
      "type": "@n8n/n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1.2,
      "position": [
        480,
        240
      ],
      "parameters": {
        "endpointUrl": "http://localhost:5678/mcp/classroom-tools",
        "serverTransport": "httpStreamable",
        "authentication": "none",
        "include": "all",
        "options": {}
      }
    }
  ],
  "connections": {
    "Chat": {
      "main": [
        [
          {
            "node": "Course Assistant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenRouter Model": {
      "ai_languageModel": [
        [
          {
            "node": "Course Assistant",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Memory": {
      "ai_memory": [
        [
          {
            "node": "Course Assistant",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Classroom MCP Tools": {
      "ai_tool": [
        [
          {
            "node": "Course Assistant",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
